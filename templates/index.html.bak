<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#070b14">
    <title>NDL Studio | Linear Streaming Channel</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
</head>
<body>
<header class="topbar">
    <div class="brand-wrap">
        <div class="brand-mark">NDL</div>
        <div>
            <div class="brand-name">NDL Studio</div>
            <div class="brand-sub">LINEAR STREAMING CHANNEL</div>
        </div>
    </div>
    <div class="top-status"><span class="dot"></span><span id="topStatus">ON AIR</span></div>
</header>

<main class="container">
    <section class="hero-grid">
        <div class="player-card">
            <div class="player-head">
                <span class="live-pill"><span class="live-dot"></span> LIVE</span>
                <span id="modeText">LOCALHOST SIMULATED-LIVE</span>
            </div>
            <div class="video-wrap">
                <video id="player" controls autoplay muted playsinline>
                    <source id="videoSource" src="/static/media/ndl_broadcast_test.mp4" type="video/mp4">
                    Your browser does not support HTML5 video.
                </video>
                <div class="watermark">NDL Studio</div>
            </div>
            <div class="player-footer">
                <div>
                    <div class="eyebrow">NOW PLAYING</div>
                    <h1 id="nowTitle">NDL Studio Broadcast Test</h1>
                    <p id="nowDescription">Loading channel data...</p>
                </div>
                <div class="clock-box">
                    <div class="eyebrow">LOCAL TIME</div>
                    <strong id="clock">--:--:--</strong>
                </div>
            </div>
        </div>

        <aside class="side-card">
            <div class="eyebrow">NEXT PROGRAMME</div>
            <h2 id="nextTitle">Loading...</h2>
            <div class="countdown-label">STARTS IN</div>
            <div class="countdown" id="countdown">00:20</div>
            <div class="progress"><div id="progressBar"></div></div>
            <div class="meta-row"><span>CHANNEL</span><strong>NDL Studio</strong></div>
            <div class="meta-row"><span>FORMAT</span><strong>LOCAL WEB TV</strong></div>
            <div class="meta-row"><span>DELIVERY</span><strong>HTTP / FLASK</strong></div>
        </aside>
    </section>

    <section class="info-grid">
        <div class="panel schedule-panel">
            <div class="panel-heading">
                <div>
                    <div class="eyebrow">PROGRAMME GUIDE</div>
                    <h2>NDL Studio Schedule</h2>
                </div>
                <span class="badge">SIMULATED LIVE</span>
            </div>
            <div id="scheduleList" class="schedule-list"></div>
        </div>

        <div class="panel poll-panel">
            <div class="eyebrow">AUDIENCE INTERACTION</div>
            <h2 id="pollQuestion">What should NDL Studio play next?</h2>
            <div id="pollOptions" class="poll-options"></div>
            <div class="poll-note">Prototype votes are stored locally in the Flask app.</div>
        </div>
    </section>

    <section class="about panel">
        <div>
            <div class="eyebrow">THE PILOT</div>
            <h2>From Localhost → Internet TV → Cable Partnership</h2>
            <p>
                This first build simulates a scheduled TV channel using prerecorded video assets.
                Later, the same concept can be connected to a real playout server, YouTube Live,
                an HLS/CDN workflow, and eventually an authorized cable/MSO distribution arrangement.
            </p>
        </div>
        <div class="stack">
            <span>FLASK</span><span>HTML/CSS/JS</span><span>PLAYOUT</span><span>EPG</span><span>POLLING</span>
        </div>
    </section>
</main>

<footer>
    <strong>NDL Studio</strong> · Local Linear Streaming Pilot · Built for development/testing
</footer>

<script src="{{ url_for('static', filename='js/app.js') }}"></script>
</body>
</html>
